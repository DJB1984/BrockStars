{
  "name": "brockstars",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "local": "vite --mode quick",
    "build": "vite build",
    "preview": "vite build && php -S 0.0.0.0:8002 -t dist",
    "package": "vite build && node tools/package-site.mjs",
    "test": "node --test tests/controls.test.mjs tests/combat.test.mjs tests/net-combat.test.mjs tests/attack.test.mjs tests/bellow.test.mjs tests/walls.test.mjs tests/showers.test.mjs tests/hit-feel.test.mjs tests/fight-readable.test.mjs tests/match.test.mjs tests/sound.test.mjs",
    "test:browser": "node tests/combat-browser.mjs",
    "test:takedown": "node tests/takedown-browser.mjs",
    "test:multiplayer": "node tests/net-combat-browser.mjs",
    "test:rooms": "node tests/rooms-browser.mjs",
    "test:showers": "node tests/showers-browser.mjs",
    "test:grapple": "node tests/grapple-browser.mjs",
    "test:grapple:multiplayer": "node tests/grapple-network-browser.mjs",
    "test:bellow": "node tests/bellow-browser.mjs",
    "test:bellow:multiplayer": "node tests/bellow-network-browser.mjs",
    "test:hitfeel": "node tests/hit-feel-browser.mjs",
    "test:hitfeel:multiplayer": "node tests/hit-feel-network-browser.mjs",
    "test:readable": "node tests/fight-readable-browser.mjs",
    "test:readable:multiplayer": "node tests/fight-readable-network-browser.mjs",
    "test:controls": "node tests/controls-browser.mjs",
    "test:controls:multiplayer": "node tests/controls-network-browser.mjs",
    "test:match": "node tests/match-network-browser.mjs"
  },
  "dependencies": {
    "@fontsource/dotgothic16": "^5.3.1",
    "@fontsource/jersey-10": "^5.3.0",
    "phaser": "3.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.3",
    "vite": "8.3.5"
  }
}
